# Optional. Defaults work without a .env file or exchange keys.
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT
TIMEFRAME=1h
PAPER_DB_PATH=data/paper.sqlite3
INITIAL_CAPITAL=1000
PAPER_LEVERAGE=25
# Per-side fee charged on notional, not on margin. Assumptions, not a fee quote.
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
ANALYSIS_INTERVAL=30

# Enable only when you want this bot to send Telegram notifications.
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
